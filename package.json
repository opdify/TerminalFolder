{
  "name": "terminal-projects",
  "displayName": "Terminal Projects",
  "description": "Manage multiple independent terminals in one VS Code workspace, especially parallel Claude CLI sessions. 在一个 VS Code 工作区中管理多个独立终端，尤其适合并行运行多个 Claude CLI 会话。",
  "version": "0.1.4",
  "publisher": "opdify",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#172554",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/opdify/vscode-terminal-projects.git"
  },
  "homepage": "https://github.com/opdify/vscode-terminal-projects#readme",
  "bugs": {
    "url": "https://github.com/opdify/vscode-terminal-projects/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "pty",
    "projects",
    "remote ssh",
    "claude",
    "claude cli",
    "ai agents"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:terminalProjects.folders",
    "onCommand:terminalProjects.addFolder",
    "onCommand:terminalProjects.openSurface"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "terminalProjects.addFolder",
        "title": "Terminal Projects: Add Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "terminalProjects.removeFolder",
        "title": "Remove Folder",
        "icon": "$(trash)"
      },
      {
        "command": "terminalProjects.addTerminal",
        "title": "New Terminal",
        "icon": "$(add)"
      },
      {
        "command": "terminalProjects.selectTerminal",
        "title": "Show Terminal"
      },
      {
        "command": "terminalProjects.renameTerminal",
        "title": "Rename Terminal",
        "icon": "$(edit)"
      },
      {
        "command": "terminalProjects.killTerminal",
        "title": "Kill Terminal",
        "icon": "$(trash)"
      },
      {
        "command": "terminalProjects.openSurface",
        "title": "Terminal Projects: Open Terminal Surface",
        "icon": "$(terminal)"
      },
      {
        "command": "terminalProjects.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "terminalProjects",
          "title": "Terminal Projects",
          "icon": "media/activity-terminal.svg"
        }
      ]
    },
    "views": {
      "terminalProjects": [
        {
          "id": "terminalProjects.folders",
          "name": "Terminal Projects",
          "type": "webview",
          "icon": "media/activity-terminal.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "terminalProjects.addFolder",
          "when": "view == terminalProjects.folders",
          "group": "navigation@1"
        },
        {
          "command": "terminalProjects.openSurface",
          "when": "view == terminalProjects.folders",
          "group": "navigation@2"
        },
        {
          "command": "terminalProjects.refresh",
          "when": "view == terminalProjects.folders",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Terminal Projects",
      "properties": {
        "terminalProjects.scrollback": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Maximum number of lines retained by each visible terminal frontend."
        },
        "terminalProjects.outputBufferBytes": {
          "type": "number",
          "default": 2097152,
          "minimum": 65536,
          "maximum": 33554432,
          "description": "Approximate maximum raw output retained per terminal so a closed Terminal Surface can be reconstructed."
        },
        "terminalProjects.shell": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional shell executable. Empty uses the remote or local extension host's normal default shell."
        },
        "terminalProjects.shellArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Arguments passed to the configured shell."
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node ./scripts/fix-node-pty.mjs",
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./esbuild.mjs",
    "watch": "node ./esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:pty": "node ./scripts/acceptance-pty.mjs",
    "package": "npm run clean && npm run check && npm run test && npm run build && node ./scripts/package-vsix.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "tree-kill": "^1.2.2",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
