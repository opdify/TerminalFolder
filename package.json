{
  "name": "terminal-folder",
  "displayName": "TerminalFolder",
  "description": "Manage multiple independent terminals by working folder, especially parallel Claude CLI sessions. 按工作目录管理多个独立终端，尤其适合并行运行多个 Claude CLI 会话。",
  "version": "0.1.0",
  "publisher": "opdify",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#172554",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/opdify/TerminalFolder.git"
  },
  "homepage": "https://github.com/opdify/TerminalFolder#readme",
  "bugs": {
    "url": "https://github.com/opdify/TerminalFolder/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "native terminal",
    "projects",
    "remote ssh",
    "claude",
    "claude cli",
    "ai agents"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:terminalFolder.folders",
    "onCommand:terminalFolder.addFolder",
    "onCommand:terminalFolder.openSurface"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "terminalFolder.addFolder",
        "title": "TerminalFolder: Add Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "terminalFolder.removeFolder",
        "title": "Remove Folder",
        "icon": "$(trash)"
      },
      {
        "command": "terminalFolder.renameFolder",
        "title": "Rename Folder",
        "icon": "$(edit)"
      },
      {
        "command": "terminalFolder.addTerminal",
        "title": "New Terminal",
        "icon": "$(add)"
      },
      {
        "command": "terminalFolder.selectTerminal",
        "title": "Show Terminal"
      },
      {
        "command": "terminalFolder.renameTerminal",
        "title": "Rename Terminal",
        "icon": "$(edit)"
      },
      {
        "command": "terminalFolder.killTerminal",
        "title": "Kill Terminal",
        "icon": "$(trash)"
      },
      {
        "command": "terminalFolder.openSurface",
        "title": "TerminalFolder: Show Managed Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "terminalFolder.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "terminalFolder",
          "title": "TerminalFolder",
          "icon": "media/activity-terminal.svg"
        }
      ]
    },
    "views": {
      "terminalFolder": [
        {
          "id": "terminalFolder.folders",
          "name": "TerminalFolder",
          "type": "webview",
          "icon": "media/activity-terminal.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "terminalFolder.addFolder",
          "when": "view == terminalFolder.folders",
          "group": "navigation@1"
        },
        {
          "command": "terminalFolder.openSurface",
          "when": "view == terminalFolder.folders",
          "group": "navigation@2"
        },
        {
          "command": "terminalFolder.refresh",
          "when": "view == terminalFolder.folders",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "TerminalFolder",
      "properties": {
        "terminalFolder.shell": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Optional shell executable. Empty uses the remote or local extension host's normal default shell."
        },
        "terminalFolder.shellArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Arguments passed to the configured shell."
        }
      }
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./esbuild.mjs",
    "watch": "node ./esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run clean && npm run check && npm run test && npm run build && node ./scripts/package-vsix.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
